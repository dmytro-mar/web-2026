{
  "name": "devjobs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:webpack": "concurrently \"webpack serve --mode=development\" \"json-server --watch api/db.json --routes api/routes.json --port 5174\"",
    "dev:vite": "concurrently \"vite\" \"json-server --watch api/db.json --routes api/routes.json --port 5174\"",
    "build:webpack": "npm run lint && webpack --mode=production",
    "build:vite": "npm run lint && vite build",
    "preview:webpack": "npm run lint && webpack serve --mode=development",
    "preview:vite": "npm run lint && vite preview",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@babel/core": "^8.1.2",
    "@babel/preset-env": "^8.0.7",
    "@eslint/js": "^10.0.1",
    "babel-loader": "^10.1.1",
    "concurrently": "^10.0.7",
    "css-loader": "^7.1.5",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "html-webpack-plugin": "^5.6.8",
    "json-server": "^0.17.4",
    "sass": "^1.108.2",
    "sass-loader": "^17.1.1",
    "style-loader": "^4.0.0",
    "vite": "^8.3.8",
    "webpack": "^5.113.0",
    "webpack-cli": "^7.3.1",
    "webpack-dev-server": "^6.1.0"
  },
  "dependencies": {
    "axios": "^1.21.1",
    "dayjs": "^1.11.23"
  }
}
